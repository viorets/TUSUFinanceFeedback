{
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "markup-test.html"],
    "headers": [
      { "source": "**/*.@(js|css|html)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/*.svg", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
    ]
  }
}
